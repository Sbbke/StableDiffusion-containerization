# syntax=docker/dockerfile:1.7
#
# Layer 1/3 - rarely changes. Rebuild only when bumping CUDA/PyTorch/base deps.
#
# Build:
#   docker buildx build --load -f Dockerfile.base -t comfy-runtime-base:cuda12.8-py312 .
#
# ------------------------------------------------------------------
# Use `-devel` only if something (nvcc) compiles CUDA code at build/run
# time. If every custom node ships prebuilt wheels, switch to the
# smaller `-runtime` variant, e.g.:
#   nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04
# ------------------------------------------------------------------
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Optional regional apt mirror. Defaults to the standard Ubuntu mirror;
# override with --build-arg APT_MIRROR=... for a faster local mirror.
ARG APT_MIRROR=archive.ubuntu.com/ubuntu
RUN if [ "$APT_MIRROR" != "archive.ubuntu.com/ubuntu" ]; then \
        sed -i "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR}|" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi

# ---------------------------------------------------------
# System dependencies
# ---------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
        python3-pip \
        build-essential \
        git \
        wget \
        curl \
        aria2 \
        nano \
        vim \
        clang \
        lldb \
        lld \
        pciutils \
        google-perftools \
        libgl1 \
        libglib2.0-0 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# uv
# ---------------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ---------------------------------------------------------
# Python virtual environment
# ---------------------------------------------------------
RUN uv venv /opt/comfy-venv -p 3.12

ENV PATH="/opt/comfy-venv/bin:$PATH" \
    UV_PYTHON=/opt/comfy-venv/bin/python \
    VIRTUAL_ENV=/opt/comfy-venv

# ---------------------------------------------------------
# PyTorch
#
# PINNED deliberately. This is the layer everything else's ABI
# compatibility (SageAttention, flash-attn, comfy-kitchen, etc) depends on -
# bump these on purpose, never let them float.
#
# 2.9.0/cu130: ComfyUI v0.32.0+ warns "You need pytorch with cu130 or
# higher to use optimized CUDA operations" and gates DynamicVRAM support
# behind torch 2.8+ specifically - this is what unlocks both. Note: cu130
# wheels only exist from torch 2.9.0 onward (2.8.0 only ships cu126/cu128),
# so 2.9.0 is the actual minimum to get a cu130 build at all.
# torchvision/torchaudio pinned per PyTorch's official pairing table.
# ---------------------------------------------------------
ARG TORCH_VERSION=2.9.0
ARG TORCHVISION_VERSION=0.24.0
ARG TORCHAUDIO_VERSION=2.9.0
ARG CUDA_CHANNEL=cu130

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        torch==${TORCH_VERSION} \
        torchvision==${TORCHVISION_VERSION} \
        torchaudio==${TORCHAUDIO_VERSION} \
        --extra-index-url https://download.pytorch.org/whl/${CUDA_CHANNEL}

# ---------------------------------------------------------
# Common AI dependencies
# ---------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        "git+https://github.com/openai/CLIP.git" \
        open_clip_torch

# ---------------------------------------------------------
# Common WAS dependencies
# ---------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        "git+https://github.com/WASasquatch/cstr.git" \
        "git+https://github.com/WASasquatch/img2texture.git" \
        "git+https://github.com/WASasquatch/ffmpy.git"

LABEL org.opencontainers.image.title="comfy-runtime-base" \
      org.opencontainers.image.description="CUDA + PyTorch base for ComfyUI images"
